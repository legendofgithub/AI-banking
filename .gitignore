# ===== Python =====
.venv/
__pycache__/
*.pyc
.pytest_cache/
# pytest --basetemp 的临时目录(批次号递增,不复用);复用会触发 safe-delete 守卫导致 rc=1 假失败
# (注意:gitignore 不支持行内注释,注释必须单独成行,否则整行都成了模式)
.pytest_tmp/

# ===== 前端 =====
webui/node_modules/
webui/.next/
webui/out/

# ===== 密钥(绝不入库)—— 任何 .env 变体一律拦截,仅模板 .env.example 例外 =====
# 背景(2026-10-09 仓库转公开):队友把 Key 填进任何名字的 env 变体
# (.env.local/.env.production/webui/.env.xxx)都必须被拦下,防手滑提交。
# 守卫测试:tests/test_env_template.py 用 git check-ignore 实测本节规则。
.env
.env.*
!.env.example
webui/.env*
!webui/.env.example

# ===== 运行时数据库/数据(演示库可随时重播种) =====
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ===== 日志与临时产物 =====
scripts_eval_*.log
scripts_eval_*.stderr
*.log
logs/
.tmp_notes/
# 调试残留:调接口时把 body/sse/登录 token 写到仓库根,一旦 add -A 即泄露凭证
# (.tmp_* 下划线与 .tmp-* 连字符两种命名都拦,2026-10-26 探针文件曾漏网)
.tmp_*
.tmp-*
.playwright-mcp/
nul

# ===== e2e 运行截图(webui/e2e-*.mjs 每次运行重新生成的输出,不入库) =====
gui-test-*/

# ===== AI 会话产物(各 AI 工具的会话目录,本地留档不入库) =====
.zcode/
.workbuddy/

# ===== 答辩材料与内部指导文档(仅本地留存,不入公开仓库) =====
