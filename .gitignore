# ===== Python =====
.venv/
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/          # pytest --basetemp 的临时目录(批次号递增,不复用);复用会触发 safe-delete 守卫导致 rc=1 假失败

# ===== 前端 =====
webui/node_modules/
webui/.next/
webui/out/

# ===== 密钥(绝不入库)—— 任何 .env 变体一律拦截,仅模板 .env.example 例外 =====
# 背景(2026-10-09 仓库转公开):队友把 Key 填进任何名字的 env 变体
# (.env.local/.env.production/webui/.env.xxx)都必须被拦下,防手滑提交。
# 守卫测试:tests/test_env_template.py 用 git check-ignore 实测本节规则。
.env
.env.*
!.env.example
webui/.env*
!webui/.env.example

# ===== 运行时数据库/数据(演示库可随时重播种) =====
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ===== 日志与临时产物 =====
scripts_eval_*.log
scripts_eval_*.stderr
*.log
logs/
.tmp_notes/
.playwright-mcp/
nul

# ===== e2e 运行截图(webui/e2e-*.mjs 每次运行重新生成的输出,不入库) =====
gui-test-*/

# ===== AI 会话产物(ZCode 每会话生成的计划文件,本地留档不入库) =====
.zcode/plans/

# ===== 系统 =====
Thumbs.db
.DS_Store

# ===== 提交压缩包(项目产物,防止 add -A 误提交整个包进库) =====
*.zip

# ===== 手机扫码二维码(scripts/make_phone_qr.py 生成物,内含当下局域网 IP,
#        换网络后会变死链,故不入库;要新的重跑脚本即可) =====
手机试用二维码.png
