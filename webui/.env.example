# ============================================================================
# 配置模板 —— 唯一必填项只有一个:ZAI_API_KEY(下方 LLM 段)。
#
# 生成 .env.local 的两条路(任选其一;文件被 .gitignore 通配拦截,不会入库):
#   ① 自动(推荐):直接运行 启动演示.bat,缺 .env.local 时会提示粘贴 Key,
#      AUTH_SECRET 本机随机生成 —— 手动 =  .venv\Scripts\python.exe scripts\setup_env.py
#   ② 手动:copy 本文件为 .env.local,填 ZAI_API_KEY,并自己生成 AUTH_SECRET
#      (openssl rand -base64 32);不填 AUTH_SECRET 登录会话签名会挂。
#
# 为什么和 vercel/chatbot 模板的 .env.example 不一样:
#   本项目的银行账号体系走 agent 后端(:8800)自有实现(浏览器 localStorage 存
#   bank-token),没有使用模板自带的 NextAuth 凭据登录 + Postgres/Redis/Vercel Blob。
#   那三个键(POSTGRES_URL / REDIS_URL / BLOB_READ_WRITE_TOKEN)在本项目中
#   **从不被读取、也不需要配置**,已从本文件移除,避免新同学白折腾。
#
# 本文件受 tests/test_env_template.py 守卫:改键/改默认值请同步该测试。
# ============================================================================

# NextAuth 会话签名密钥(留空,由 scripts/setup_env.py 随机生成;见文件头②)
AUTH_SECRET=

# 前端自身访问地址(必填;不配会导致 3000 端口登录跳转异常)
AUTH_URL=http://127.0.0.1:3000

# agent 后端端口(选填,不写默认 8800)
# ⚠️ 代码读的是 **PORT** 不是 URL:webui 里用的是
#    process.env.NEXT_PUBLIC_AGENT_API_PORT ?? "8800"
#    写成 NEXT_PUBLIC_AGENT_API_URL 是**不生效的**(那是历史残留键)。
NEXT_PUBLIC_AGENT_API_PORT=8800

# ---- LLM 配置(必填)-------------------------------------------------------
# 这三个变量由**后端** agent/llm.py 读取;`启动演示.bat` 也会从本文件回填它们。
# ⚠️ 三个必须一起改:只换 Key、不换 BASE_URL,会变成
#    "A 家的 Key 打到 B 家端点"这种必挂组合(2026-10-09 踩过:智谱欠费后切 DeepSeek)。
# 当前可用组合(DeepSeek):
ZAI_BASE_URL=https://api.deepseek.com/
ZAI_MODEL=deepseek-chat
ZAI_API_KEY=

# 验证配置是否生效:
#   curl http://127.0.0.1:8800/health     # 返回的 model 字段应为上面填的模型
